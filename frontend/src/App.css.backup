/* 전체 앱 스타일 */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-color: #f8fafc;
}

.App {
  display: flex;
  min-height: 100vh;
}

.App-content {
  flex: 1;
  margin-left: 280px; /* Navigation width */
  overflow-x: auto;
}

/* Responsive design */
@media (max-width: 768px) {
  .App {
    flex-direction: column;
  }
  
  .App-content {
    margin-left: 0;
    margin-top: 0; /* Navigation height in mobile */
  }
}
  margin: 0 0 1.5rem 0;
  color: #333;
  font-size: 1.5rem;
  font-weight: 600;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #667eea;
}

/* 플레이스홀더 */
.placeholder {
  text-align: center;
  padding: 3rem 1rem;
  color: #666;
}

.placeholder h3 {
  margin: 0 0 1rem 0;
  color: #333;
}

.placeholder p {
  margin: 0;
  font-size: 1rem;
  line-height: 1.5;
}

/* 푸터 */
.App-footer {
  background-color: #333;
  color: white;
  text-align: center;
  padding: 1rem;
  margin-top: 2rem;
}

.App-footer p {
  margin: 0;
  opacity: 0.8;
}

/* 반응형 디자인 */
@media (max-width: 768px) {
  .App-main {
    padding: 1rem;
  }
  
  .App-header h1 {
    font-size: 2rem;
  }
  
  .section {
    padding: 1rem;
  }
}
